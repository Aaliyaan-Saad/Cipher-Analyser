BruteXorScreen ENDP

; CipherCore.inc - algorithms only; no console or operating-system calls.
; All buffers supplied by callers must have enough capacity.
; USES preserves listed registers. EAX and flags are return/scratch values.

; CaesarTransform
; IN: ESI=source, EDI=destination (length+1 bytes), ECX=length,
;     EBX=forward shift in 0..25. Decrypt by passing (26-key) mod 26.
; OUT: null-terminated destination. Nonletters unchanged. In-place is safe.
CaesarTransform PROC USES ebx ecx edx esi edi
    test ecx, ecx
    jz ctDone
ctNext:
    mov al, [esi]
    cmp al, 'A'
    jb ctStore
    cmp al, 'Z'
    jbe ctUpper
    cmp al, 'a'
    jb ctStore
    cmp al, 'z'
    ja ctStore
    mov dl, 'a'
    jmp ctShift
ctUpper:
    mov dl, 'A'
ctShift:
    sub al, dl                 ; letter -> index 0..25
    add al, bl                 ; index -> 0..50
    cmp al, 26
    jb ctRestore
    sub al, 26                 ; one subtraction is sufficient
ctRestore:
    add al, dl
ctStore:
    mov [edi], al
    inc esi
    inc edi
    dec ecx
    jnz ctNext
ctDone:
    mov BYTE PTR [edi], 0
    ret
CaesarTransform ENDP

; XorTransform
; IN: ESI=source, EDI=destination (length+1 bytes), ECX=length, BL=key.
; OUT: destination bytes and a convenience terminator AFTER the payload.
; ALWAYS use ECX/length for ciphertext: a zero byte can occur inside it.
XorTransform PROC USES ebx ecx esi edi
    test ecx, ecx
    jz xtDone
xtNext:
    mov al, [esi]
    xor al, bl
    mov [edi], al
    inc esi
    inc edi
    dec ecx
    jnz xtNext
xtDone:
    mov BYTE PTR [edi], 0
    ret
XorTransform ENDP

; CountCharacters
; IN: ESI=source, ECX=length, EDI=26 DWORD frequencies,
;     EDX=5 DWORD counts: uppercase, lowercase, digits, spaces, other.
; OUT: both arrays reset then filled; frequencies combine letter case.
CountCharacters PROC USES ebx ecx edx esi edi ebp
    mov ebx, edx
    xor eax, eax
    xor ebp, ebp
ccClearFreq:
    mov DWORD PTR [edi+ebp*4], 0
    inc ebp
    cmp ebp, 26
    jb ccClearFreq
    xor ebp, ebp
ccClearCounts:
    mov DWORD PTR [ebx+ebp*4], 0
    inc ebp
    cmp ebp, 5
    jb ccClearCounts
    test ecx, ecx
    jz ccDone
ccNext:
    movzx eax, BYTE PTR [esi]
    cmp al, 'A'
    jb ccDigit
    cmp al, 'Z'
    jbe ccUpper
    cmp al, 'a'
    jb ccOther
    cmp al, 'z'
    ja ccOther
    inc DWORD PTR [ebx+4]
    sub eax, 'a'
    jmp ccLetter
ccUpper:
    inc DWORD PTR [ebx]
    sub eax, 'A'
ccLetter:
    inc DWORD PTR [edi+eax*4]
    jmp ccAdvance
ccDigit:
    cmp al, '0'
    jb ccSpace
    cmp al, '9'
    ja ccOther
    inc DWORD PTR [ebx+8]
    jmp ccAdvance
ccSpace:
    cmp al, ' '
    jne ccOther
    inc DWORD PTR [ebx+12]
    jmp ccAdvance
ccOther:
    inc DWORD PTR [ebx+16]
ccAdvance:
    inc esi
    dec ecx
    jnz ccNext
ccDone:
    ret
CountCharacters ENDP

; ParseUnsigned
; IN: ESI=ASCII digits, ECX=length, EDX=maximum (0..255 only).
; OUT: CF=0/EAX=value on success, CF=1 on empty/invalid/out-of-range.
; Checking the bound after EACH digit prevents 32-bit overflow because
; the previous partial value never exceeds 255. Signs/spaces forbidden.
ParseUnsigned PROC USES ebx ecx esi edi
    xor eax, eax
    test ecx, ecx
    jz puBad
puNext:
    movzx ebx, BYTE PTR [esi]
    cmp bl, '0'
    jb puBad
    cmp bl, '9'
    ja puBad
    sub ebx, '0'
    mov edi, eax               ; value*10 = (value<<3) + (value<<1)
    shl eax, 3
    shl edi, 1
    add eax, edi
    add eax, ebx
    cmp eax, edx
    ja puBad
    inc esi
    dec ecx
    jnz puNext
    clc
    ret
puBad:
    stc
    ret
ParseUnsigned ENDP

; EqualBytes: ESI/EDI=buffers, ECX=length; EAX=1 if equal else 0.
; Length-based comparison supports embedded zero bytes.
EqualBytes PROC USES ecx edx esi edi
    mov eax, 1
    test ecx, ecx
    jz eqDone
eqNext:
    mov dl, [esi]
    cmp dl, [edi]
    jne eqNo
    inc esi
    inc edi
    dec ecx
    jnz eqNext
    ret
eqNo:
    xor eax, eax
eqDone:
    ret
EqualBytes ENDP

